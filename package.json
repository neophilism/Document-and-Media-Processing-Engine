{
  "name": "@accountability/document-media-processing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./docker-pdf": {
      "types": "./dist/docker-pdf.d.ts",
      "default": "./dist/docker-pdf.js"
    },
    "./docker-ocr": {
      "types": "./dist/docker-ocr.d.ts",
      "default": "./dist/docker-ocr.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && node scripts/validate-pr-registry.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test:docker": "node --test integration/docker-pdf.test.ts",
    "test:docker:ocr": "node --test integration/docker-ocr.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ]
}
